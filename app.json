{
  "expo": {
    "name": "smartcook-mobile",
    "slug": "smartcook-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartcookmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SmartCook cần truy cập microphone để bạn có thể nói chuyện rảnh tay với trợ lý bếp khi đang nấu ăn.",
        "NSSpeechRecognitionUsageDescription": "SmartCook cần nhận diện giọng nói để hiểu các câu hỏi khi nấu ăn."
      }
    },
    "android": {
      "package": "com.smartcook.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "SmartCook cần truy cập ảnh bạn chọn để nhận diện món ăn và nguyên liệu.",
          "cameraPermission": "SmartCook cần camera để chụp món ăn và nhận diện nguyên liệu."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép SmartCook sử dụng máy ảnh để quét và nhận diện nguyên liệu thực phẩm."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "819f5c77-d445-41cd-abef-7777f2a7b740"
      }
    },
    "owner": "quynv64"
  }
}
